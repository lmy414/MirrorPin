{
  "name": "mirrorpin-core",
  "version": "0.1.0",
  "description": "拼豆图纸生成工具 · 算法内核（M0）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mirrorpin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "perler",
    "beads",
    "mard",
    "pixel-art"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
