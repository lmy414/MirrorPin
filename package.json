{
  "name": "mirrorpin-core",
  "version": "0.3.0",
  "description": "拼豆图纸生成工具 · 算法内核（M1：L0/引导滤波保边 + DPID 保细节降采样）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mirrorpin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./render-node": {
      "types": "./dist/render-node.d.ts",
      "import": "./dist/render-node.js",
      "require": "./dist/render-node.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "test": "vitest run",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "build:webapp": "node scripts/build-webapp.mjs",
    "build:minitool": "node scripts/build-minitool.mjs",
    "serve:minitool": "node scripts/serve-minitool.mjs",
    "serve:webapp": "node scripts/serve-webapp.mjs",
    "webapp": "npm run build:webapp && npm run serve:webapp"
  },
  "keywords": [
    "perler",
    "beads",
    "mard",
    "pixel-art"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.27.7",
    "pngjs": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "fft.js": "^4.0.4",
    "sharp": "^0.35.3"
  }
}
